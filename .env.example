# ---- App ----
SECRET_KEY=troque-isso-por-uma-chave-aleatoria-longa
FLASK_ENV=production
BASE_URL=https://app.seudominio.com

# ---- Banco (PostgreSQL) ----
DATABASE_URL=postgresql://usuario:senha@localhost:5432/autoseo_clone

# ---- IA (cascata: Claude -> Gemini -> Ollama) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
GOOGLE_API_KEY=AIzaSyxxxxxxxx
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Google OAuth (Search Console) ----
# Crie em https://console.cloud.google.com/apis/credentials
# Ative "Google Search Console API" e crie um OAuth Client ID (Web application)
# Redirect URI: {BASE_URL}/analytics/google/callback
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxx

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx
STRIPE_PRICE_ID_MONTHLY=price_xxxxxxxx   # plano de $100/mês
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# ---- E-mail transacional (SMTP) ----
# Se deixar em branco, os e-mails só são logados no console (não trava o app)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@seudominio.com

# ---- Admin inicial (criado automaticamente no primeiro boot) ----
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=troque-esta-senha
